
linters: lintr::linters_with_defaults(
  indentation_linter = lintr::indentation_linter(
    indent=2L,
    hanging_indent_style = "tidy"
    ),
  line_length_linter = lintr::line_length_linter(120L),
  object_name_linter = lintr::object_name_linter(styles="snake_case"),
  closed_curly_linter = NULL
)